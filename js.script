
/* =========================================
   FBI INVESTIGATION SYSTEM
   FALLAKTE 001 – MORD AM PRÄSIDENTEN
========================================= */

"use strict";

// =========================================
// 1. SYSTEM INITIALISIEREN
// =========================================

let timeLeft = 3600;
let timerInterval = null;
let timerRunning = false;

const progress = {
    puzzle1: false,
    puzzle2: false,
    vault: false,
    final: false
};

const hints = {
    1: "Die Uhr blieb um 23:15 Uhr stehen. Verwende vier Ziffern ohne Doppelpunkt.",
    2: "Der Brief deutet auf jemanden hin, der politische Macht gewinnen möchte.",
    3: "Der geheime Tresor verwendet dieselbe Uhrzeit wie der erste Beweis."
};

window.addEventListener("DOMContentLoaded", () => {
    console.log("FBI INVESTIGATION SYSTEM ONLINE");

    document.body.classList.add("loaded");

    updateTimer();
    updateProgress();
    initializeEffects();
});


// =========================================
// 2. COUNTDOWN SYSTEM
// =========================================

function updateTimer() {
    const display = document.getElementById("timer");

    if (!display) return;

    const minutes = Math.floor(timeLeft / 60);
    const seconds = timeLeft % 60;

    display.textContent =
        String(minutes).padStart(2, "0") +
        ":" +
        String(seconds).padStart(2, "0");

    display.classList.toggle("timer-danger", timeLeft <= 300);
}

function startTimer() {
    if (timerRunning || timeLeft <= 0 || progress.final) return;

    timerRunning = true;

    timerInterval = setInterval(() => {
        timeLeft--;

        updateTimer();

        if (timeLeft <= 0) {
            pauseTimer();

            showMessage(
                "timerMessage",
                "🚨 ZEIT ABGELAUFEN! Der Fall bleibt ungelöst.",
                "error"
            );

            document.body.classList.add("time-expired");
        }

    }, 1000);
}

function pauseTimer() {
    clearInterval(timerInterval);
    timerInterval = null;
    timerRunning = false;
}

function resetTimer() {
    pauseTimer();

    timeLeft = 3600;

    document.body.classList.remove("time-expired");

    updateTimer();

    showMessage(
        "timerMessage",
        "Countdown wurde zurückgesetzt.",
        "success"
    );
}


// =========================================
// 3. RÄTSEL 01 – DIE MYSTERIÖSE UHR
// =========================================

function checkPuzzle1() {
    const input = document.getElementById("answer1");
    const result = document.getElementById("result1");

    if (!input || !result) return;

    const answer = input.value.trim().replace(":", "");

    if (progress.puzzle1) {
        showMessage("result1", "✓ Dieser Beweis wurde bereits untersucht.", "success");
        return;
    }

    if (answer === "2315") {

        progress.puzzle1 = true;

        showMessage(
            "result1",
            "✓ BEWEIS BESTÄTIGT! Die Uhr blieb um 23:15 Uhr stehen. Ein wichtiger Hinweis wurde registriert.",
            "success"
        );

        input.disabled = true;

        playSound(800);
        updateProgress();
        unlockEffect();

    } else {

        showMessage(
            "result1",
            "✕ FALSCHE ZEIT! Untersuche die Uhr noch einmal.",
            "error"
        );

        playSound(200);
    }
}


// =========================================
// 4. RÄTSEL 02 – DER GEHEIME BRIEF
// =========================================

function checkPuzzle2() {
    const input = document.getElementById("answer2");
    const result = document.getElementById("result2");

    if (!input || !result) return;

    const answer = input.value.trim().toLowerCase();

    if (progress.puzzle2) {
        showMessage("result2", "✓ Der Brief wurde bereits ausgewertet.", "success");
        return;
    }

    if (!progress.puzzle1) {
        showMessage(
            "result2",
            "🔒 ZUGRIFF GESPERRT! Löse zuerst Rätsel 01.",
            "error"
        );
        return;
    }

    if (answer === "vice") {

        progress.puzzle2 = true;

        showMessage(
            "result2",
            "✓ VERDÄCHTIGER IDENTIFIZIERT! Der Vizepräsident hatte ein mögliches Motiv.",
            "success"
        );

        input.disabled = true;

        playSound(900);
        updateProgress();
        unlockEffect();

    } else {

        showMessage(
            "result2",
            "✕ FALSCHE SPUR! Dieser Verdächtige passt nicht zum Brief.",
            "error"
        );

        playSound(200);
    }
}


// =========================================
// 5. GEHEIMER TRESOR
// =========================================

function openVault() {
    const input = document.getElementById("vaultCode");
    const result = document.getElementById("vaultResult");
    const secret = document.getElementById("secret");

    if (!input || !result || !secret) return;

    if (progress.vault) {
        showMessage("vaultResult", "✓ Tresor ist bereits geöffnet.", "success");
        return;
    }

    if (!progress.puzzle1 || !progress.puzzle2) {
        showMessage(
            "vaultResult",
            "🔒 SICHERHEITSSPERRE! Löse zuerst beide Rätsel.",
            "error"
        );
        return;
    }

    if (input.value.trim() === "2315") {

        progress.vault = true;

        showMessage(
            "vaultResult",
            "ACCESS GRANTED // TRESOR ERFOLGREICH GEÖFFNET",
            "success"
        );

        secret.hidden = false;
        input.disabled = true;

        playSound(1100);
        updateProgress();
        unlockEffect();

        secret.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });

    } else {

        showMessage(
            "vaultResult",
            "ACCESS DENIED // FALSCHER SICHERHEITSCODE",
            "error"
        );

        secret.hidden = true;

        playSound(180);
    }
}


// =========================================
// 6. TÄTER ENTLARVEN
// =========================================

function solveCase() {
    const input = document.getElementById("finalSuspect");
    const result = document.getElementById("finalResult");

    if (!input || !result) return;

    const suspect = input.value;

    if (progress.final) return;

    if (!progress.vault) {
        showMessage(
            "finalResult",
            "🔒 ZUGRIFF VERWEIGERT! Öffne zuerst den geheimen Tresor.",
            "error"
        );
        return;
    }

    if (!suspect) {
        showMessage(
            "finalResult",
            "Bitte wähle zuerst einen Verdächtigen aus.",
            "error"
        );
        return;
    }

    if (suspect === "vice") {

        progress.final = true;

        pauseTimer();

        result.innerHTML = `
            <div class="secret-box">
                <h3>🚨 CLASSIFIED // CASE SOLVED</h3>

                <h2 style="color:#42e8ff;">
                    DER VIZEPRÄSIDENT
                </h2>

                <p>
                    Deine Ermittlungen haben die Wahrheit aufgedeckt.
                    Der Vizepräsident wollte selbst die Macht übernehmen.
                </p>

                <p>
                    Er fürchtete, dass der Präsident seine geheimen
                    politischen Pläne aufdecken würde.
                </p>

                <p>
                    Die Uhr, der Brief und die Dokumente im Tresor
                    führten zur entscheidenden Spur.
                </p>

                <h3>🏆 GLÜCKWUNSCH, DETEKTIV!</h3>

                <p>FALLAKTE 001 ERFOLGREICH ABGESCHLOSSEN.</p>

                <p>MISSION STATUS: COMPLETE</p>
            </div>
        `;

        result.scrollIntoView({
            behavior: "smooth",
            block: "center"
        });

        updateProgress();
        playSound(1200);

        document.body.classList.add("case-solved");

        launchConfetti();

    } else {

        showMessage(
            "finalResult",
            "✕ FALSCHE ANSCHULDIGUNG! Die Beweise sprechen gegen diese Person.",
            "error"
        );

        playSound(200);
    }
}


// =========================================
// 7. HINWEIS-SYSTEM
// =========================================

function showHint(number) {
    const hint = hints[number];

    if (!hint) return;

    const element = document.getElementById("hint" + number);

    if (element) {

        element.hidden = false;

        element.innerHTML = `
            <strong>🕵️ GEHEIME INFORMATION</strong>
            <p>${hint}</p>
        `;

        element.scrollIntoView({
            behavior: "smooth",
            block: "nearest"
        });

    } else {

        showMessage(
            "result" + number,
            "🕵️ HINWEIS: " + hint,
            "info"
        );
    }

    playSound(600);
}


// =========================================
// 8. FORTSCHRITTSANZEIGE
// =========================================

function updateProgress() {

    const completed = Object.values(progress).filter(Boolean).length;

    const percentage = completed * 25;

    const bar = document.getElementById("progressBar");
    const text = document.getElementById("progressText");

    if (bar) {
        bar.style.width = percentage + "%";
    }

    if (text) {
        text.textContent =
            percentage + "% DER ERMITTLUNGEN ABGESCHLOSSEN";
    }

    const counter = document.getElementById("clueCounter");

    if (counter) {
        counter.textContent = completed + " / 4 BEWEISE";
    }
}


// =========================================
// 9. NACHRICHTEN-SYSTEM
// =========================================

function showMessage(id, message, type) {

    const element = document.getElementById(id);

    if (!element) return;

    element.textContent = message;

    element.classList.remove(
        "success-message",
        "error-message",
        "info-message"
    );

    if (type === "success") {
        element.classList.add("success-message");
    }

    if (type === "error") {
        element.classList.add("error-message");
    }

    if (type === "info") {
        element.classList.add("info-message");
    }
}


// =========================================
// 10. SOUND SYSTEM
// =========================================

let audioContext = null;

function playSound(frequency) {

    try {

        audioContext ??= new (
            window.AudioContext ||
            window.webkitAudioContext
        )();

        if (audioContext.state === "suspended") {
            audioContext.resume();
        }

        const oscillator = audioContext.createOscillator();
        const gain = audioContext.createGain();

        oscillator.connect(gain);
        gain.connect(audioContext.destination);

        oscillator.frequency.value = frequency;
        oscillator.type = "sine";

        gain.gain.setValueAtTime(
            0.12,
            audioContext.currentTime
        );

        gain.gain.exponentialRampToValueAtTime(
            0.001,
            audioContext.currentTime + 0.35
        );

        oscillator.start();
        oscillator.stop(audioContext.currentTime + 0.35);

    } catch (error) {
        console.log("Audio nicht verfügbar.");
    }
}


// =========================================
// 11. VISUELLE EFFEKTE
// =========================================

function unlockEffect() {

    document.body.classList.add("evidence-unlocked");

    setTimeout(() => {
        document.body.classList.remove("evidence-unlocked");
    }, 1000);
}

function initializeEffects() {

    const cards = document.querySelectorAll(
        ".suspect-card, .evidence"
    );

    cards.forEach(card => {

        card.addEventListener("mouseenter", () => {
            card.style.transition = "0.3s ease";
        });

    });

}


// =========================================
// 12. KONFETTI BEI GEWONNENEM FALL
// =========================================

function launchConfetti() {

    const colors = ["#42e8ff", "#ff3d50", "#e5bd70", "#ffffff"];

    for (let i = 0; i < 65; i++) {

        const particle = document.createElement("div");

        particle.style.position = "fixed";
        particle.style.left = Math.random() * 100 + "vw";
        particle.style.top = "-15px";
        particle.style.width = "7px";
        particle.style.height = "12px";
        particle.style.background =
            colors[Math.floor(Math.random() * colors.length)];

        particle.style.zIndex = "99999";
        particle.style.pointerEvents = "none";
        particle.style.borderRadius = "2px";

        document.body.appendChild(particle);

        const duration = 2000 + Math.random() * 2000;

        const animation = particle.animate(
            [
                {
                    transform: "translateY(0) rotate(0deg)",
                    opacity: 1
                },
                {
                    transform:
                        `translateY(${window.innerHeight + 50}px) rotate(${Math.random() * 900}deg)`,
                    opacity: 0
                }
            ],
            {
                duration: duration,
                easing: "ease-in"
            }
        );

        animation.onfinish = () => particle.remove();
    }
}


